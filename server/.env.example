PORT=5000
MONGO_URI=mongodb://localhost:27017/serverpilot
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Must be exactly 32 bytes when base64-decoded (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
ENCRYPTION_KEY=change_this_base64_32_byte_key

# Comma-separated list of allowed origins: the web app, plus the Electron
# desktop app's local origin (fixed port, see desktop/main.js).
CLIENT_ORIGIN=http://localhost:5173,http://localhost:51734
